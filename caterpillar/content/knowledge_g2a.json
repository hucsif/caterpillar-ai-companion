  "math": {
    "units": [
      {
        "no": 1,
        "name": "分类与整理",
        "weeks": [
          1,
          2
        ],
        "kps": [
          {
            "type": "concept",
            "imp": 3,
            "content": "可以按不同标准分类：同一堆气球，按形状分和按颜色分，结果不一样"
          },
          {
            "type": "concept",
            "imp": 3,
            "content": "分类后用画图、写数等方式记录结果，能看出哪种最多、哪种最少"
          },
          {
            "type": "concept",
            "imp": 2,
            "content": "初步认识简单统计表，会用统计结果回答问题"
          }
        ]
      },
      {
        "no": 2,
        "name": "1～6的表内乘法",
        "weeks": [
          3,
          4,
          5,
          6
        ],
        "kps": [
          {
            "type": "concept",
            "imp": 3,
            "content": "乘法的意义：求几个相同加数的和，用乘法算更简便。3+3+3+3 就是 4个3，写作 3×4"
          },
          {
            "type": "concept",
            "imp": 3,
            "content": "乘法算式各部分：乘数×乘数=积；×读作'乘'"
          },
          {
            "type": "formula",
            "imp": 3,
            "content": "1～6的乘法口诀：一一得一……六六三十六，重点是5的口诀和6的口诀"
          },
          {
            "type": "concept",
            "imp": 3,
            "content": "用口诀求积：想'五六三十'，所以 5×6=30，6×5 也用同一句口诀"
          }
        ]
      },
      {
        "no": 3,
        "name": "1～6的表内除法",
        "weeks": [
          7,
          8,
          9
        ],
        "kps": [
          {
            "type": "concept",
            "imp": 3,
            "content": "平均分：每份分得同样多叫平均分。12个苹果平均分给3人，每人4个"
          },
          {
            "type": "concept",
            "imp": 3,
            "content": "除法的意义：把一个数平均分成几份求每份是多少，或求一个数里有几个另一个数，用除法。÷读作'除以'"
          },
          {
            "type": "concept",
            "imp": 3,
            "content": "用乘法口诀求商：30÷6，想'五六三十'，商是5"
          },
          {
            "type": "concept",
            "imp": 2,
            "content": "被除数÷除数=商，乘除法是互逆关系"
          }
        ]
      },
      {
        "no": 4,
        "name": "校园小导游（综合实践）",
        "weeks": [
          10
        ],
        "kps": [
          {
            "type": "concept",
            "imp": 2,
            "content": "认识东、南、西、北四个方向：太阳升起的方向是东方，面向东，后面是西，左面是北，右面是南"
          },
          {
            "type": "concept",
            "imp": 2,
            "content": "会用方向词描述校园里建筑物的位置，制作方向牌"
          }
        ]
      },
      {
        "no": 5,
        "name": "厘米和米",
        "weeks": [
          11,
          12
        ],
        "kps": [
          {
            "type": "concept",
            "imp": 3,
            "content": "测量长度要用统一的长度单位；量比较短的物体用厘米(cm)，量比较长的物体用米(m)"
          },
          {
            "type": "formula",
            "imp": 3,
            "content": "1米 = 100厘米"
          },
          {
            "type": "concept",
            "imp": 3,
            "content": "用尺子测量：物体左端对准0刻度，右端对着几就是几厘米"
          },
          {
            "type": "concept",
            "imp": 2,
            "content": "认识线段：线段是直的，有两个端点，可以量出长度"
          }
        ]
      },
      {
        "no": 6,
        "name": "身体上的尺子（综合实践）",
        "weeks": [
          13
        ],
        "kps": [
          {
            "type": "concept",
            "imp": 2,
            "content": "身体上的'尺子'：一拃、一步、一庹，可以用来估测长度"
          },
          {
            "type": "concept",
            "imp": 2,
            "content": "先估一估再量一量，培养估测意识"
          }
        ]
      },
      {
        "no": 7,
        "name": "7～9的表内乘、除法",
        "weeks": [
          14,
          15,
          16,
          17
        ],
        "kps": [
          {
            "type": "formula",
            "imp": 3,
            "content": "7的乘法口诀：一七得七……七七四十九"
          },
          {
            "type": "formula",
            "imp": 3,
            "content": "8的乘法口诀：一八得八……八八六十四"
          },
          {
            "type": "formula",
            "imp": 3,
            "content": "9的乘法口诀：一九得九……九九八十一，9的口诀有规律：积的十位比乘数少1，十位与个位相加等于9"
          },
          {
            "type": "concept",
            "imp": 3,
            "content": "用7～9的口诀求商，乘除混合解决实际问题"
          }
        ]
      },
      {
        "no": 8,
        "name": "复习与关联",
        "weeks": [
          18,
          19,
          20
        ],
        "kps": [
          {
            "type": "formula",
            "imp": 3,
            "content": "乘法口诀表全表：从一一得一到九九八十一，横着背、竖着背、拐弯背"
          },
          {
            "type": "concept",
            "imp": 3,
            "content": "全册知识关联复习：分类、乘除法、厘米和米、位置与方向"
          }
        ]
      },
